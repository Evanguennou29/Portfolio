---
import data from "../../content/data.json";

interface Props {
  lang: "fr" | "en";
}
const { lang } = Astro.props;
const positions = [
  { x: 112, y: 104, label: "Syntho Crowd", side: "end" },
  { x: 350, y: 80, label: "Sign'iA", side: "end" },
  { x: 625, y: 126, label: "Anomaly City", side: "start" },
  { x: 172, y: 282, label: "IDP", side: "end" },
  { x: 455, y: 250, label: "Eco2Mix ELT", side: "end" },
  { x: 655, y: 350, label: "LeoChat", side: "start" },
  { x: 344, y: 430, label: "DECP Copilot", side: "end" },
] as const;
---

<div class="atlas">
  <svg
    viewBox="0 0 760 510"
    aria-label={
      lang === "fr" ? "Carte des projets publics" : "Map of public projects"
    }
  >
    <defs>
      <pattern
        id="atlas-grid"
        width="38"
        height="38"
        patternUnits="userSpaceOnUse"
      >
        <path
          d="M38 0H0V38"
          fill="none"
          stroke="currentColor"
          stroke-width=".45"
        />
      </pattern>
      <linearGradient id="atlas-line" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--accent)" />
        <stop offset=".6" stop-color="var(--signal)" />
        <stop offset="1" stop-color="var(--accent)" />
      </linearGradient>
    </defs>
    <rect width="760" height="510" fill="url(#atlas-grid)" class="atlas-grid" />
    <g class="atlas-edges">
      <path d="M112 104C180 22 286 52 350 80" />
      <path d="M350 80C455 48 554 84 625 126" />
      <path d="M112 104C82 186 106 252 172 282" />
      <path d="M172 282C270 224 355 225 455 250" />
      <path d="M455 250C552 252 624 290 655 350" />
      <path d="M172 282C202 365 260 416 344 430" />
      <path d="M344 430C476 445 560 402 655 350" />
      <path d="M350 80C374 150 414 207 455 250" />
    </g>
    {data.projects.map((project, index) => {
      const position = positions[index];
      if (!position) return null;
      return (
        <a
          href={`#project-${project.slug}`}
          class="atlas-node"
          data-atlas-node
          data-roles={project.roles.join(" ")}
          aria-label={
            lang === "fr"
              ? `Aller au projet ${project.title}`
              : `Jump to project ${project.title}`
          }
        >
          <circle class="node-halo" cx={position.x} cy={position.y} r="18" />
          <circle class="node-core" cx={position.x} cy={position.y} r="4" />
          <text
            x={position.x + (position.side === "start" ? 18 : -18)}
            y={position.y - 15}
            text-anchor={position.side === "start" ? "start" : "end"}
          >
            {position.label}
          </text>
        </a>
      );
    })}
    <g class="atlas-legend" aria-hidden="true">
      <text x="14" y="492">
        DATA / MODELS / INTERFACES
      </text>
      <text x="744" y="492" text-anchor="end">
        07 NODES / 08 LINKS
      </text>
    </g>
  </svg>
  <nav
    class="atlas-mobile-index"
    aria-label={lang === "fr" ? "Projets" : "Projects"}
  >
    {data.projects.map((project, index) => (
      <a href={`#project-${project.slug}`}>
        {positions[index]?.label ?? project.title}
      </a>
    ))}
  </nav>
</div>

<style>
  .atlas {
    width: 100%;
    aspect-ratio: 760 / 510;
    color: var(--line);
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .atlas-grid {
    opacity: 0.44;
  }
  .atlas-guides {
    fill: none;
    stroke: var(--line);
    stroke-width: 0.7;
    opacity: 0.7;
  }
  .atlas-edges {
    fill: none;
    stroke: url(#atlas-line);
    stroke-width: 1.4;
    opacity: 0.72;
  }
  .atlas-edges path {
    stroke-dasharray: 6 10;
    animation: atlas-flow 8s linear infinite;
  }
  .atlas-edges path:nth-child(2n) {
    animation-duration: 12s;
    animation-direction: reverse;
  }
  .atlas-node {
    color: var(--text);
    text-decoration: none;
    cursor: pointer;
  }
  .atlas-node .node-halo {
    fill: color-mix(in srgb, var(--accent) 12%, var(--bg));
    stroke: var(--accent);
    stroke-width: 1;
    transition:
      r 0.3s,
      fill 0.3s;
  }
  .atlas-node .node-core {
    fill: var(--signal);
  }
  .atlas-node text {
    fill: var(--text);
    font: 500 12px var(--font-mono);
    letter-spacing: 0.015em;
    paint-order: stroke fill;
    stroke: var(--bg);
    stroke-width: 3px;
    transition: fill 0.3s;
  }
  .atlas-node:hover .node-halo,
  .atlas-node:focus .node-halo {
    r: 24;
    fill: color-mix(in srgb, var(--signal) 20%, var(--bg));
  }
  .atlas-node[data-relevant="true"] .node-halo {
    fill: color-mix(in srgb, var(--accent) 24%, var(--bg));
    stroke-width: 2;
  }
  .atlas-node:hover text,
  .atlas-node:focus text {
    fill: var(--signal);
  }
  .atlas-legend text {
    fill: var(--muted);
    font: 400 9px var(--font-mono);
    letter-spacing: 0.12em;
  }
  .atlas-mobile-index {
    display: none;
  }
  @keyframes atlas-flow {
    to {
      stroke-dashoffset: -160;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-edges path {
      animation: none;
    }
    .atlas-node .node-halo,
    .atlas-node text {
      transition: none;
    }
  }
  @media (max-width: 550px) {
    .atlas {
      aspect-ratio: auto;
    }
    svg {
      height: auto;
      aspect-ratio: 760 / 510;
    }
    .atlas-node text,
    .atlas-legend {
      display: none;
    }
    .atlas-mobile-index {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 4px 0 12px;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
    }
    .atlas-mobile-index::-webkit-scrollbar {
      display: none;
    }
    .atlas-mobile-index a {
      flex: 0 0 auto;
      padding: 6px 9px;
      border: 1px solid var(--line);
      color: var(--text);
      background: var(--surface);
      font: 400 0.68rem var(--font-mono);
      text-decoration: none;
      scroll-snap-align: start;
    }
  }
</style>
