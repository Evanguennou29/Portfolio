---
interface Props {
  number: string;
  title: string;
  id?: string;
}

const { number, title, id } = Astro.props;
---

<div class="section-heading">
  <p class="section-index mono">{number} /</p>
  <h2 id={id}>{title}</h2>
</div>

<style>
  .section-heading {
    display: grid;
    grid-template-columns: minmax(3rem, 1fr) minmax(0, 11fr);
    gap: var(--space-4);
    align-items: baseline;
    margin-block-end: var(--space-8);
    padding-block-end: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .section-index {
    margin: 0;
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 3rem);
  }

  @media (max-width: 520px) {
    .section-heading {
      grid-template-columns: 2.4rem minmax(0, 1fr);
      gap: var(--space-3);
    }
  }
</style>
