---
interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname.replace(/^\/+/, "");
const basePath = base.replace(/^\/+|\/+$/g, "");
const localPath = basePath
  ? pathname.toLowerCase() === basePath.toLowerCase()
    ? ""
    : pathname.toLowerCase().startsWith(`${basePath.toLowerCase()}/`)
      ? pathname.slice(basePath.length + 1)
      : pathname
  : pathname;
const normalizedPath = localPath.replace(/^\/+|\/+$/g, "");
const projectSlug = normalizedPath.startsWith("en/projects/")
  ? normalizedPath.slice("en/projects/".length)
  : normalizedPath.startsWith("projets/")
    ? normalizedPath.slice("projets/".length)
    : "";
const targetPath =
  lang === "fr"
    ? projectSlug
      ? `en/projects/${projectSlug}/`
      : "en/"
    : projectSlug
      ? `projets/${projectSlug}/`
      : "";
const href = `${base}${targetPath}${Astro.url.search}`;
const targetLang = lang === "fr" ? "en" : "fr";
---

<a
  class="lang-switch mono"
  href={href}
  lang={targetLang}
  aria-label={lang === "fr" ? "English version" : "Version française"}
>
  {targetLang === "en" ? (
    <svg class="language-flag" viewBox="0 0 20 14" aria-hidden="true">
      <rect width="20" height="14" fill="#012169" />
      <path d="m0 0 20 14M20 0 0 14" stroke="#fff" stroke-width="3.5" />
      <path d="m0 0 20 14M20 0 0 14" stroke="#c8102e" stroke-width="1.25" />
      <path d="M10 0v14M0 7h20" stroke="#fff" stroke-width="4.5" />
      <path d="M10 0v14M0 7h20" stroke="#c8102e" stroke-width="2" />
    </svg>
  ) : (
    <svg class="language-flag" viewBox="0 0 20 14" aria-hidden="true">
      <rect width="6.67" height="14" fill="#1f3d8a" />
      <rect x="6.67" width="6.66" height="14" fill="#fff" />
      <rect x="13.33" width="6.67" height="14" fill="#ed2939" />
    </svg>
  )}
  <span>{targetLang === "en" ? "English" : "Français"}</span>
</a>

<style>
  .lang-switch {
    display: inline-flex;
    min-width: 80px;
    height: 40px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding-inline: 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 56%, var(--line));
    border-radius: var(--radius);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
    font-size: 0.68rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      background-color 160ms ease;
  }

  .lang-switch:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, var(--surface));
  }

  .language-flag {
    width: 18px;
    height: 13px;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
  }
</style>
