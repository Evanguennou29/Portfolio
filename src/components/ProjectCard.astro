          />
          <rect
            class="illustration-panel"
            x="88"
            y="23"
            width="64"
            height="42"
            rx="2"
          />
          <rect
            class="illustration-panel"
            x="22"
            y="22"
            width="54"
            height="38"
            rx="2"
          />
          <rect
            class="illustration-panel"
            x="164"
            y="22"
            width="54"
            height="38"
            rx="2"
          />
          <rect
            class="illustration-panel"
            x="17"
            y="126"
            width="62"
            height="38"
            rx="2"
          />
          <rect
            class="illustration-panel"
            x="161"
            y="126"
            width="62"
            height="38"
            rx="2"
          />
          <circle class="illustration-node" cx="120" cy="88" r="13" />
          <circle class="illustration-node" cx="52" cy="42" r="4" />
          <circle class="illustration-node" cx="189" cy="42" r="4" />
          <circle class="illustration-node" cx="48" cy="145" r="4" />
          <circle class="illustration-node" cx="192" cy="145" r="4" />
        </>
      )}
      {project.slug === "pulv-chatbot" && (
        <>
          <rect
            class="illustration-panel"
            x="18"
            y="35"
            width="42"
            height="60"
            rx="2"
          />
          <rect
            class="illustration-panel"
            x="29"
            y="47"
            width="42"
            height="60"
            rx="2"
          />
          <path
            class="illustration-flow"
            d="M71 77H104m0 0-9-9m9 9-9 9m9-9h33m0 0-9-9m9 9-9 9m9-9h22"
          />
          <circle class="illustration-node" cx="119" cy="77" r="17" />
          <rect
            class="illustration-panel"
            x="161"
            y="48"
            width="60"
            height="58"
            rx="2"
          />
          <path class="illustration-guide" d="M172 64h37m-37 12h28m-28 12h34" />
          <path class="illustration-guide" d="M178 128h34l-11 14v-14" />
