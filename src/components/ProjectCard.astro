            d="M70 35v19h17m-48 12h32m-32 12h28m-28 12h31"
          />
          <path class="illustration-flow" d="M91 89h42m0 0-9-9m9 9-9 9" />
          <rect
            class="illustration-panel"
            x="145"
            y="45"
            width="72"
            height="88"
            rx="2"
          />
          <path
            class="illustration-guide"
            d="M158 66h45m-45 15h45m-45 15h31m-31 15h40"
          />
          <circle class="illustration-node" cx="189" cy="145" r="4" />
        </>
      )}
    </svg>
    <span class="mark-coordinate mono">
      {String(index + 1).padStart(2, "0")}
    </span>
  </div>
  <div class="project-copy">
    <h3>
      <a
        class="project-title-link"
        href={`${base}${lang === "en" ? "en/projects" : "projets"}/${project.slug}/`}
        transition:name={`project-title-${project.slug}`}
      >
        {title}
      </a>
    </h3>
    {project.question?.[lang] && (
      <p class="project-question">{project.question[lang]}</p>
    )}
    {summary && <p class="project-summary">{summary}</p>}
    <ul
      class="stack-list"
      aria-label={lang === "fr" ? "Technologies" : "Technologies"}
    >
      {project.stack.slice(0, 6).map((item) => (
        <li class="mono">{item}</li>
      ))}
    </ul>
    <div class="project-links">
      {validLink(project.links.repo) && (
        <a href={project.links.repo} target="_blank" rel="noreferrer">
          {lang === "fr" ? "Voir le dépôt" : "View repository"}{" "}
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {validLink(project.links.demo) && (
        <a href={project.links.demo} target="_blank" rel="noreferrer">
          {lang === "fr" ? "Voir la démo" : "View demo"}{" "}
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    min-height: 390px;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .project-card[data-featured="true"] {
    grid-column: span 4;
  }

  .project-card:hover {
    border-color: var(--accent);
  }

  .project-card::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    background: radial-gradient(
      circle 280px at var(--spot-x, 50%) var(--spot-y, 50%),
      color-mix(in srgb, var(--accent) 12%, transparent),
      transparent 100%
    );
    content: "";
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-card[data-featured="false"] {
    grid-column: 1 / -1;
    display: grid;
    min-height: 0;
    grid-template-columns: minmax(100px, 2fr) minmax(0, 10fr);
    align-items: center;
    padding: var(--space-4);
    background: transparent;
  }

  .project-card[data-featured="false"] .card-topline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 0;
  }

  .project-card[data-featured="false"] .project-mark,
  .project-card[data-featured="false"] .project-question,
  .project-card[data-featured="false"] .stack-list {
    display: none;
  }

  .project-card[data-featured="false"] .project-copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-6);
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .project-card[data-featured="false"] h3 {
    max-width: none;
    margin: 0;
    font-size: 1.05rem;
  }

  .project-card[data-featured="false"] .project-summary {
    grid-column: 1;
    margin: var(--space-2) 0 0;
    font-size: 0.88rem;
  }

  .project-card[data-featured="false"] .project-links {
    grid-column: 2;
    grid-row: 1 / span 2;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }

  .card-topline {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-4) 0;
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .project-mark {
    position: absolute;
    top: 54px;
    right: var(--space-5);
    width: min(46%, 250px);
    aspect-ratio: 4 / 3;
    opacity: 0.72;
  }

  .project-illustration {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .illustration-guide,
  .illustration-flow,
  .illustration-panel {
    stroke: color-mix(in srgb, var(--accent) 58%, var(--muted));
    stroke-width: 1.4;
  }

  .illustration-guide {
    stroke: var(--line);
  }

  .illustration-flow {
    stroke: var(--accent);
    stroke-dasharray: 280;
    stroke-dashoffset: 0;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .illustration-panel {
    fill: color-mix(in srgb, var(--surface) 82%, transparent);
  }

  .illustration-node {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 1.7;
    transform-box: fill-box;
    transform-origin: center;
  }

  .project-card:hover .illustration-flow {
    animation: blueprint-flow 900ms ease-out both;
  }

  .project-card:hover .illustration-node {
    animation: blueprint-pulse 520ms ease-out both;
  }

  @keyframes blueprint-flow {
    from {
      stroke-dashoffset: 280;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes blueprint-pulse {
    50% {
      transform: scale(1.4);
    }
  }

  .mark-coordinate {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    color: var(--accent);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.1em;
  }

  .project-copy {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding: var(--space-8) var(--space-4) var(--space-4);
  }

  h3 {
    max-width: 85%;
    margin-block-end: var(--space-3);
    font-size: clamp(1.55rem, 3vw, 2.1rem);
  }

  .project-title-link {
    color: inherit;
    text-decoration: none;
  }

  .project-title-link:hover {
    color: var(--accent);
  }

  .project-question,
  .project-summary {
    max-width: 48ch;
    margin-block-end: var(--space-3);
    color: var(--muted);
    font-size: 0.94rem;
  }

  .project-question {
    color: var(--text);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .stack-list li {
    padding: 3px 7px;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.62rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  .project-links a {
    color: var(--accent);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
  }

  .project-links a span {
    display: inline-block;
    margin-inline-start: 0.2em;
    transition: transform 150ms ease;
  }

  .project-links a:hover span {
    transform: translate(2px, -2px);
  }

  @media (max-width: 800px) {
    .project-card[data-featured="true"] {
      grid-column: span 6;
    }

    .project-card[data-featured="true"][data-card-index="03"] {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .project-card {
      min-height: 340px;
    }

    .project-card[data-featured="true"] {
      grid-column: 1 / -1;
    }

    .project-mark {
      width: 38%;
    }

    .project-copy {
      padding-inline: var(--space-3);
    }

    .project-card[data-featured="false"] {
      grid-template-columns: minmax(56px, 2fr) minmax(0, 10fr);
      gap: var(--space-3);
      padding: var(--space-3);
    }

    .project-card[data-featured="false"] .project-copy {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-card[data-featured="false"] .project-links {
      grid-column: 1;
      grid-row: auto;
      flex-direction: row;
      margin-block-start: var(--space-2);
    }
  }
</style>
