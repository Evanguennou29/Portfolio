---
import data from "../../content/data.json";

type Project = (typeof data.projects)[number];

interface Props {
  project: Project;
  index: number;
  featured: boolean;
  lang?: "fr" | "en";
}

const { project, index, featured, lang = "fr" } = Astro.props;
const localized = (value: string | { fr: string; en: string } | undefined) =>
  typeof value === "string" ? value : value?.[lang];
const title = localized(project.title);
const summary = localized(project.summary);
const base = import.meta.env.BASE_URL;
const validLink = (value: string) =>
  value && !value.toLowerCase().includes("todo");
---

<article
  class="project-card"
  data-card-index={String(index + 1).padStart(2, "0")}
  data-project-card
  data-roles={project.roles.join(" ")}
  data-featured={String(featured)}
>
  <div class="card-topline mono">
    <span>{project.year}</span>
    <span>{project.status.toUpperCase()}</span>
  </div>
  <div
    class="project-mark"
    aria-hidden="true"
    transition:name={`project-media-${project.slug}`}
  >
    <svg class="project-illustration" viewBox="0 0 240 180" fill="none">
      {project.slug === "eco2mix-elt" && (
        <>
          <path
            class="illustration-guide"
            d="M22 34H218M22 74H218M22 114H218M22 154H218"
          />
          <path
            class="illustration-guide"
            d="M22 24V158M72 24V158M122 24V158M172 24V158M218 24V158"
          />
          <path
            class="illustration-flow"
            d="m24 126 27-8 25 3 24-36 23 15 24-30 25 11 21-46 25 16"
          />
          <circle class="illustration-node" cx="172" cy="81" r="4" />
          <circle class="illustration-node" cx="193" cy="35" r="4" />
        </>
      )}
      {project.slug === "syntho-crowd" && (
