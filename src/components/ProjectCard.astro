---
import data from "../../content/data.json";

type Project = (typeof data.projects)[number];

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const localized = (value: string | { fr: string; en: string } | undefined) =>
  typeof value === "string" ? value : value?.fr;
const title = localized(project.title);
const summary = localized(project.summary);
const validLink = (value: string) =>
  value && !value.toLowerCase().includes("todo");
---

<article
  class="project-card"
  data-card-index={String(index + 1).padStart(2, "0")}
>
  <div class="card-topline mono">
    <span>{project.year}</span>
    <span>{project.status.toUpperCase()}</span>
  </div>
  <div class="project-mark" aria-hidden="true">
    <div class="mark-frame">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <span class="mark-coordinate mono">
      {String(index + 1).padStart(2, "0")}
    </span>
  </div>
  <div class="project-copy">
    <h3>{title}</h3>
    {project.question?.fr && (
      <p class="project-question">{project.question.fr}</p>
    )}
    {summary && <p class="project-summary">{summary}</p>}
    <ul class="stack-list" aria-label="Technologies">
      {project.stack.slice(0, 6).map((item) => (
        <li class="mono">{item}</li>
      ))}
    </ul>
    <div class="project-links">
      {validLink(project.links.repo) && (
        <a href={project.links.repo} target="_blank" rel="noreferrer">
          Voir le dépôt <span aria-hidden="true">↗</span>
        </a>
      )}
      {validLink(project.links.demo) && (
        <a href={project.links.demo} target="_blank" rel="noreferrer">
          Voir la démo <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    min-height: 390px;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .project-card:hover {
    border-color: var(--accent);
  }

  .card-topline {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-4) 0;
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .project-mark {
    position: absolute;
    top: 60px;
    right: var(--space-4);
    width: 40%;
    max-width: 190px;
    aspect-ratio: 1;
    opacity: 0.58;
  }

  .mark-frame {
    position: absolute;
    inset: 8%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8%;
    transform: rotate(45deg);
  }

  .mark-frame span {
    border: 1px solid color-mix(in srgb, var(--accent) 62%, var(--line));
    background: repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 9px,
      color-mix(in srgb, var(--accent) 18%, transparent) 10px
    );
  }

  .mark-frame span:nth-child(2) {
    transform: translateY(-12%);
  }

  .mark-coordinate {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    color: var(--accent);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.1em;
  }

  .project-copy {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding: var(--space-8) var(--space-4) var(--space-4);
  }

  h3 {
    max-width: 85%;
    margin-block-end: var(--space-3);
    font-size: clamp(1.55rem, 3vw, 2.1rem);
  }

  .project-question,
  .project-summary {
    max-width: 48ch;
    margin-block-end: var(--space-3);
    color: var(--muted);
    font-size: 0.94rem;
  }

  .project-question {
    color: var(--text);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .stack-list li {
    padding: 3px 7px;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.62rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-start: var(--space-4);
  }

  .project-links a {
    color: var(--accent);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
  }

  .project-links a span {
    display: inline-block;
    margin-inline-start: 0.2em;
    transition: transform 150ms ease;
  }

  .project-links a:hover span {
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .project-card {
      min-height: 340px;
    }

    .project-mark {
      width: 34%;
    }

    .project-copy {
      padding-inline: var(--space-3);
    }
  }
</style>
