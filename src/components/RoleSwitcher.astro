---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import data from "../../content/data.json";

interface Props {
  lang?: "fr" | "en";
}

const { lang = "fr" } = Astro.props;
const base = import.meta.env.BASE_URL;
const queryFor = (id: string) => {
  if (id === "ai-engineer") return "ai";
  if (id === "ml-engineer") return "ml";
  return id;
};
const fallbackCv = `${base}cv/evan-guennou-ai-engineer-${lang}.pdf`;
const cvFor = (id: string) => {
  const filename = `evan-guennou-${id}-${lang}.pdf`;
  return existsSync(resolve(process.cwd(), "public", "cv", filename))
    ? `${base}cv/${filename}`
    : fallbackCv;
};
---

<div class="role-switcher" data-role-switcher>
  <p class="role-label mono">
    {lang === "fr" ? "Missions ciblées" : "Target missions"}
  </p>
  <div
    class="role-options"
    role="group"
    aria-label={
      lang === "fr" ? "Choisir une mission cible" : "Choose a target mission"
    }
  >
    {data.roles.map((role, index) => (
      <button
        class="role-option"
        type="button"
        data-target-role
        data-role-id={role.id}
        data-role-query={queryFor(role.id)}
        data-pitch={role.pitch[lang]}
        data-cv-url={cvFor(role.id)}
        data-cv-fallback={fallbackCv}
        aria-pressed={index === 0 ? "true" : "false"}
      >
        <span class="role-mark" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span>{role.label}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .role-switcher {
    margin: 0;
  }

  .role-label {
    margin-block-end: 15px;
    color: var(--text);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .role-options {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .role-option {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 42px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 0;
    color: var(--muted);
    background: var(--surface);
    cursor: pointer;
    font-size: 0.76rem;
    transition:
      border-color 220ms ease,
      color 160ms ease,
      transform 160ms ease,
      background 220ms ease;
  }

  .role-option:hover {
    color: var(--text);
    transform: translateY(-1px);
  }

  .role-option[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--bg);
    background: var(--accent);
  }

  .role-option:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .role-mark {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 18px;
  }
  .role-mark i {
    display: block;
    width: 2px;
    height: 5px;
    background: currentColor;
    opacity: 0.8;
    transition: height 250ms ease;
  }
  .role-mark i:nth-child(2) {
    height: 13px;
  }
  .role-mark i:nth-child(3) {
    height: 8px;
  }
  .role-option:hover .role-mark i:first-child,
  .role-option[aria-pressed="true"] .role-mark i:first-child {
    height: 13px;
  }
  .role-option:hover .role-mark i:nth-child(2),
  .role-option[aria-pressed="true"] .role-mark i:nth-child(2) {
    height: 7px;
  }
  @media (prefers-reduced-motion: reduce) {
    .role-mark i {
      transition: none;
    }
  }
</style>
