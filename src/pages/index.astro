---
import data from "../../content/data.json";
import EmailCopy from "../components/EmailCopy.astro";
import ProjectCard from "../components/ProjectCard.astro";
import RoleSwitcher from "../components/RoleSwitcher.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Base from "../layouts/Base.astro";

const featuredProjects = data.projects
  .filter((project) => project.featured)
  .slice(0, 3);
const featuredSet = new Set(featuredProjects.map((project) => project.slug));
const base = import.meta.env.BASE_URL;

const formatMonth = (date: string) =>
  new Date(`${date}-01T00:00:00Z`).toLocaleDateString("fr-FR", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
---

<Base lang="fr">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="hero-identity">
        <p class="hero-name mono">{data.person.name}</p>
        <img
          class="hero-portrait"
          src={`${base}${data.person.portrait.src}`}
          alt={data.person.portrait.alt.fr}
          width="144"
          height="144"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <h1 id="hero-title">{data.person.title.fr}</h1>
      <p class="hero-tagline">{data.person.tagline.fr}</p>
      <p class="role-pitch" aria-hidden="true">
        <span data-pitch-visual>{data.roles[0]?.pitch.fr}</span>
      </p>
      <span class="visually-hidden" data-pitch-accessible aria-live="polite">
        {data.roles[0]?.pitch.fr}
      </span>
      <div class="hero-meta mono">
        <span>{data.person.experienceSummary.fr}</span>
        <span>{data.person.availability.fr}</span>
      </div>
      <RoleSwitcher lang="fr" />
      <div class="hero-actions">
        <a
          class="button button-primary cv-download"
          data-cv-download
          href={`${base}cv/evan-guennou-ai-engineer-fr.pdf`}
        >
          <span>Télécharger mon CV</span>
          <span class="cv-format mono">PDF</span>
          <span aria-hidden="true">↓</span>
        </a>
        <a
          class="button button-secondary"
          href={data.person.links.github}
          target="_blank"
          rel="noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-text" href="#contact">
          Me contacter <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <figure class="process-figure" aria-labelledby="process-title">
      <figcaption id="process-title" class="mono">
        Donnée / Modèle / Produit
      </figcaption>
      <svg
        viewBox="0 0 520 270"
        role="img"
        aria-labelledby="diagram-title diagram-description"
      >
        <title id="diagram-title">De la donnée au produit</title>
        <desc id="diagram-description">
          Une ligne relie trois étapes, Donnée, Modèle et Produit.
        </desc>
        <path class="process-line" d="M45 142h430" />
        <path class="process-line process-line-secondary" d="M45 152h430" />
        <circle class="process-node" cx="65" cy="147" r="20" />
        <circle class="process-node" cx="260" cy="147" r="20" />
        <circle class="process-node" cx="455" cy="147" r="20" />
        <circle class="process-pulse" r="4">
          <animateMotion
            dur="4.8s"
            repeatCount="indefinite"
            path="M65 147H455"
          />
        </circle>
        <path class="node-tick" d="M65 110v-18m195 18V74m195 36V92" />
        <text x="65" y="70" text-anchor="middle">
          Donnée
        </text>
        <text x="260" y="52" text-anchor="middle">
          Modèle
        </text>
        <text x="455" y="70" text-anchor="middle">
          Produit
        </text>
        <text class="diagram-index" x="65" y="205" text-anchor="middle">
          01
        </text>
        <text class="diagram-index" x="260" y="205" text-anchor="middle">
          02
        </text>
        <text class="diagram-index" x="455" y="205" text-anchor="middle">
          03
        </text>
      </svg>
    </figure>
  </section>

  <section class="quick-facts" aria-label="Informations pratiques">
    <div class="fact-cell">
      <p class="fact-label mono">Disponibilité</p>
      <p>{data.person.availability.fr}</p>
    </div>
    <div class="fact-cell">
      <p class="fact-label mono">Localisation</p>
      <p>{data.person.location.fr}</p>
    </div>
    <div class="fact-cell">
      <p class="fact-label mono">Mobilité</p>
      <p>
        {data.person.mobility.fr.toLowerCase().includes("todo")
          ? ""
          : data.person.mobility.fr}
      </p>
    </div>
    <div class="fact-cell">
      <p class="fact-label mono">Contrat recherché</p>
      <p>{data.person.contract.fr}</p>
    </div>
    <div class="fact-cell fact-languages">
      <p class="fact-label mono">Langues</p>
      <ul>
        {data.person.languages.map((language) => (
          <li>{language.fr}</li>
        ))}
      </ul>
    </div>
    <div class="fact-cell fact-email">
      <p class="fact-label mono">Email</p>
      <a href={`mailto:${data.person.email}`}>{data.person.email}</a>
      <EmailCopy email={data.person.email} />
    </div>
  </section>

  <section
    class="content-section skills-section"
    id="skills"
    aria-labelledby="skills-title"
  >
    <SectionHeading number="01" title="Compétences" id="skills-title" />
    <div class="skills-matrix">
      {data.skills.map((group, index) => (
        <article
          class="skill-group"
          data-skill-group
          data-roles={group.roles.join(" ")}
        >
          <p class="skill-index mono">{String(index + 1).padStart(2, "0")}</p>
          <h3>{group.domain.fr}</h3>
          <ul class="skill-list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section
    class="content-section experience-section"
    id="experience"
    aria-labelledby="experience-title"
  >
    <SectionHeading
      number="02"
      title="Expériences professionnelles"
      id="experience-title"
    />
    <div class="timeline">
      {data.experience.map((job) => (
        <article class="timeline-entry">
          <div class="timeline-date mono">
            <span>{formatMonth(job.start)}</span>
            <span>à {formatMonth(job.end)}</span>
          </div>
          <div class="timeline-content">
            <div class="timeline-heading">
              <h3>{job.role.fr}</h3>
              <span class="experience-location mono">{job.location}</span>
            </div>
            <p class="job-title">{job.company}</p>
            <p class="job-team">{job.team.fr}</p>
            {job.context?.fr && (
              <div class="experience-block context-block">
                <p class="experience-label mono">Contexte et objectifs</p>
                <p class="job-context">{job.context.fr}</p>
              </div>
            )}
            <div class="experience-block missions-block">
              <p class="experience-label mono">Missions</p>
              {job.missionGroups.map((group, groupIndex) => (
                <section class="mission-group">
                  <h4>
                    <span class="mission-index mono">
                      {String(groupIndex + 1).padStart(2, "0")}
                    </span>
                    {group.title.fr}
                  </h4>
                  <ul class="job-points">
                    {group.points.fr.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
            <div class="experience-block technical-block">
              <p class="experience-label mono">Environnement technique</p>
              <ul class="stack-list" aria-label="Technologies">
                {job.stack.map((item) => (
                  <li class="mono">{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section
    class="content-section projects-section"
    id="projects"
    aria-labelledby="projects-title"
  >
    <SectionHeading number="03" title="Projets" id="projects-title" />
    <div class="project-collection" data-project-collection>
      {data.projects.map((project, index) => (
        <ProjectCard
          project={project}
          index={index}
          featured={featuredSet.has(project.slug)}
        />
      ))}
    </div>
  </section>

  <section
    class="content-section education-section"
    id="education"
    aria-label="Formation et certifications"
  >
    <SectionHeading number="04" title="Parcours" />
    <div class="education-list">
      {data.education.map((item) => (
        <article class="education-entry">
          <p class="education-date mono">
            {item.start} à {item.end}
          </p>
          <div>
            <h3>{item.school}</h3>
            <p class="education-degree">{item.degree.fr}</p>
            {item.details?.fr && (
              <p class="education-details">{item.details.fr}</p>
            )}
          </div>
        </article>
      ))}
    </div>
    <div class="certifications">
      <p class="fact-label mono">Certifications</p>
      <ul class="certification-list">
        {data.certifications.map((certification) => (
          <li>{certification}</li>
        ))}
      </ul>
    </div>
  </section>

  <section
    class="content-section beyond-section"
    id="beyond"
    aria-label="Au-delà du code"
  >
    <SectionHeading number="05" title="Au-delà du code" />
    <ul class="beyond-list">
      {data.beyond.map((item) => (
        <li>{item.fr}</li>
      ))}
    </ul>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div>
      <p class="contact-index mono">Contact /</p>
      <h2 id="contact-title">{data.person.email}</h2>
    </div>
    <div class="contact-actions">
      <a class="button button-primary" href={`mailto:${data.person.email}`}>
        Écrire un email <span aria-hidden="true">↗</span>
      </a>
      <EmailCopy email={data.person.email} />
      <div class="social-links">
        <a href={data.person.links.github} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a href={data.person.links.linkedin} target="_blank" rel="noreferrer">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initializeRoleTarget } from "../scripts/role-target";

  initializeRoleTarget();
  document.addEventListener("astro:page-load", initializeRoleTarget);
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    gap: clamp(var(--space-8), 7vw, var(--space-16));
    align-items: center;
    padding-block: clamp(64px, 10vw, 128px);
    border-bottom: 1px solid var(--line);
  }

  .hero-name,
  .hero-meta,
  .process-figure figcaption,
  .fact-label,
  .compact-year,
  .skill-index,
  .education-date,
  .contact-index {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-name {
    margin-block-end: var(--space-4);
    color: var(--accent);
  }

  .hero::before,
  .hero::after {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    content: "";
  }

  .hero::before {
    top: 12%;
    right: 2%;
    width: min(38vw, 430px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-radial-gradient(
      circle,
      transparent 0 23px,
      color-mix(in srgb, var(--accent) 16%, transparent) 24px 25px,
      transparent 26px 49px
    );
    mask-image: radial-gradient(circle, #000 28%, transparent 74%);
    animation: blueprint-drift 48s linear infinite;
  }

  .hero::after {
    top: 50%;
    right: 19%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 72%, transparent);
    transform-origin: -146px 0;
    animation: blueprint-orbit 20s linear infinite;
  }

  @keyframes blueprint-drift {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes blueprint-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  h1 {
    margin-block-end: var(--space-4);
    font-size: clamp(3.2rem, 8vw, 7.25rem);
  }

  .hero-tagline {
    max-width: 27ch;
    margin-block-end: var(--space-6);
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    line-height: 1.3;
  }

  .role-pitch {
    max-width: 57ch;
    min-height: 3.2em;
    margin-block: calc(-1 * var(--space-3)) var(--space-4);
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin-block-end: var(--space-8);
    color: var(--muted);
    text-transform: none;
  }

  .hero-meta span:first-child {
    color: var(--signal);
  }

  .hero-actions,
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-size: 0.87rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .button-primary {
    border-color: var(--accent);
    color: #0b0d10;
    background: var(--accent);
  }

  :root[data-theme="light"] .button-primary {
    color: #fff;
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) .button-primary {
      color: #fff;
    }
  }

  .button-primary:hover {
    background: color-mix(in srgb, var(--accent) 82%, var(--text));
  }

  .cv-download {
    min-height: 54px;
    gap: var(--space-3);
    padding-inline: var(--space-6);
    box-shadow: 0 5px 18px color-mix(in srgb, var(--accent) 24%, transparent);
  }

  .cv-download:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 34%, transparent);
  }

  .cv-format {
    padding: 0 5px;
    border: 1px solid currentColor;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
  }

  .button-secondary {
    border-color: var(--line);
    background: var(--surface);
  }

  .button-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .button-text {
    padding-inline: var(--space-2);
    color: var(--muted);
  }

  .button-text:hover {
    color: var(--accent);
  }

  .process-figure {
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
  }

  .process-figure figcaption {
    color: var(--muted);
  }

  .process-figure svg {
    display: block;
    width: 100%;
    overflow: visible;
  }

  .process-figure text {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .process-figure .diagram-index {
    fill: var(--muted);
    font-size: 10px;
  }

  .process-line {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 5 6;
    animation: draw-line 1.2s ease-out both;
  }

  .process-line-secondary {
    opacity: 0.55;
    animation-delay: 100ms;
  }

  .process-node {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .process-pulse {
    fill: var(--signal);
    filter: drop-shadow(0 0 5px var(--signal));
  }

  .node-tick {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  @keyframes draw-line {
    from {
      stroke-dashoffset: 120;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-pulse,
    .hero::before,
    .hero::after {
      display: none;
    }
  }

  .quick-facts {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    margin-block: var(--space-16) var(--space-24);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .fact-cell {
    grid-column: span 4;
    min-width: 0;
    min-height: 138px;
    padding: var(--space-4);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .fact-label {
    margin-block-end: var(--space-3);
    color: var(--muted);
  }

  .fact-cell > p:not(.fact-label) {
    margin-block-end: 0;
  }

  .fact-languages ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact-languages li {
    color: var(--text);
    font-size: 0.9rem;
  }

  .fact-email > a {
    display: block;
    width: fit-content;
    margin-block-end: var(--space-3);
    color: var(--accent);
  }

  .content-section {
    margin-block-end: var(--space-24);
    scroll-margin-top: calc(120px + var(--space-4));
  }

  .project-collection {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .timeline {
    border-left: 1px solid var(--line);
  }

  .timeline-entry {
    position: relative;
    display: grid;
    grid-template-columns: 2fr 10fr;
    gap: var(--space-8);
    padding: var(--space-5) 0 var(--space-12) var(--space-8);
  }

  .timeline-entry::before {
    position: absolute;
    top: calc(var(--space-5) + 0.5em);
    left: -4px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    content: "";
  }

  .timeline-date {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--muted);
    font-size: 0.67rem;
  }

  .timeline-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .timeline-heading h3 {
    margin: 0;
    font-size: 1.45rem;
  }

  .timeline-heading > span,
  .job-team {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .job-title {
    margin: var(--space-2) 0 0;
    color: var(--accent);
  }

  .job-team {
    margin-block: var(--space-1) var(--space-6);
  }

  .experience-block {
    position: relative;
    margin-block-start: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
  }

  .experience-label {
    margin-block-end: var(--space-3);
    color: var(--accent);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .context-block {
    border-left: 2px solid var(--accent);
  }

  .job-context {
    margin: 0;
  }

  .mission-group + .mission-group {
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .mission-group h4 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .mission-index {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .job-context {
    max-width: 75ch;
    color: var(--muted);
  }

  .job-points {
    display: grid;
    gap: var(--space-3);
    max-width: 78ch;
    margin: var(--space-3) 0 0;
    padding-left: 1.2rem;
  }

  .job-points li::marker {
    color: var(--accent);
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .stack-list li {
    padding: 3px 7px;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.62rem;
  }

  .technical-block .stack-list {
    margin-block: 0;
  }

  .skills-matrix {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .skill-group {
    min-height: 225px;
    padding: var(--space-4);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .skill-group[data-relevant="true"] {
    box-shadow: inset 0 2px 0 var(--accent);
  }

  .skill-list li {
    transition: color 180ms ease;
  }

  .skill-group[data-relevant="true"] .skill-list li {
    color: var(--text);
  }

  .skill-index {
    margin-block-end: var(--space-6);
    color: var(--accent);
  }

  .skill-group h3 {
    margin-block-end: var(--space-4);
    font-size: 1.15rem;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-list li {
    color: var(--muted);
    font-size: 0.86rem;
  }

