---
import data from "../../content/data.json";
import "@fontsource-variable/inter-tight/wght.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/grid.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import CommandPalette from "../components/CommandPalette.astro";
import LangSwitch from "../components/LangSwitch.astro";
import { ClientRouter } from "astro:transitions";
import { absoluteUrl, getRouteKey, seoPages } from "../lib/seo";

interface Props {
  lang?: "fr" | "en";
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  lang = "fr",
  title: titleOverride,
  description: descriptionOverride,
  noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const routeKey = getRouteKey(Astro.url.pathname, base);
const page = seoPages.find(
  (item) =>
    item.lang === lang && item.path.replace(/^\/+|\/+$/g, "") === routeKey,
);
const title =
  titleOverride ??
  page?.title ??
  `${data.person.title[lang]} | ${data.person.name}`;
const description =
  descriptionOverride ?? page?.description ?? data.person.tagline[lang];
const homeHref = `${base}${lang === "en" ? "en/" : ""}`;
const routePath = page?.path ?? routeKey;
const site = Astro.site;
const canonical = site ? absoluteUrl(site, base, routePath) : undefined;
const frenchAlternate =
  site && page ? absoluteUrl(site, base, page.frenchPath) : undefined;
const englishAlternate =
  site && page ? absoluteUrl(site, base, page.englishPath) : undefined;
const openGraphPath = `og/${page?.image ?? `${lang}-home`}.png`;
const openGraphImage = site
  ? absoluteUrl(site, base, openGraphPath)
  : `${base}${openGraphPath}`;
const personUrl = site ? absoluteUrl(site, base, "") : undefined;
const isHomepage = routeKey === "" || routeKey === "en";
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": personUrl ? `${personUrl}#person` : undefined,
  name: data.person.name,
  jobTitle: data.person.title[lang],
  description: data.person.tagline[lang],
  email: `mailto:${data.person.email}`,
  url: personUrl,
  homeLocation: { "@type": "Place", name: data.person.location[lang] },
  sameAs: [data.person.links.github, data.person.links.linkedin],
};
const jsonLd = JSON.stringify(personSchema).replaceAll("<", "\\u003c");
const isProject = page?.path.startsWith(
  lang === "fr" ? "projets/" : "en/projects/",
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0d10" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {frenchAlternate && (
      <link rel="alternate" hreflang="fr" href={frenchAlternate} />
    )}
    {englishAlternate && (
      <link rel="alternate" hreflang="en" href={englishAlternate} />
    )}
    {frenchAlternate && (
      <link rel="alternate" hreflang="x-default" href={frenchAlternate} />
    )}
    <meta property="og:type" content={isProject ? "article" : "website"} />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:site_name" content={data.person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={openGraphImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={openGraphImage} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <script type="application/ld+json" set:html={jsonLd} />}
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {lang === "fr" ? "Aller au contenu" : "Skip to content"}
    </a>
    <div class="blueprint-grid" aria-hidden="true"></div>
    <div class="site-shell">
      <header class="site-header">
        <div class="header-main">
          <a class="wordmark" href={homeHref}>
            {data.person.name}
          </a>
          <div class="header-tools">
            <LangSwitch lang={lang} />
            <CommandPalette lang={lang} />
            <ThemeToggle lang={lang} />
          </div>
        </div>
        {isHomepage && (
          <nav
            class="section-nav mono"
            aria-label={
              lang === "fr" ? "Navigation principale" : "Main navigation"
            }
          >
            <a href={`${homeHref}#skills`}>
              <span>01</span> {lang === "fr" ? "Compétences" : "Skills"}
            </a>
            <a href={`${homeHref}#experience`}>
              <span>02</span> {lang === "fr" ? "Expériences" : "Experience"}
            </a>
            <a href={`${homeHref}#projects`}>
              <span>03</span> {lang === "fr" ? "Projets" : "Projects"}
            </a>
          </nav>
        )}
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  import { initializeMotion } from "../scripts/motion";

  initializeMotion();
  document.addEventListener("astro:page-load", initializeMotion);
</script>

<style>
  .header-tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
